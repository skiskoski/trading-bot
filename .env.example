# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Alpaca Paper Trading ──────────────────────────────────────────────────────
# Sign up free at: https://alpaca.markets → Paper Trading
# Dashboard → API Keys → Generate New Key
TRADEBOT_ALPACA_API_KEY=PKxxxxxxxxxxxxxxxxxxxxxxxx
TRADEBOT_ALPACA_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TRADEBOT_ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Telegram Notifications ────────────────────────────────────────────────────
# 1. Open Telegram, search @BotFather
# 2. Send: /newbot  → follow prompts → copy the TOKEN below
# 3. Start a chat with your new bot (send any message)
# 4. Visit: https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#    Find "chat":{"id": <NUMBER>} → that's your CHAT_ID
TRADEBOT_TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TRADEBOT_TELEGRAM_CHAT_ID=987654321

# ── Optional overrides ────────────────────────────────────────────────────────
# TRADEBOT_UNIVERSE_SIZE=100
# TRADEBOT_HOLDOUT_START=2024-01-01
# TRADEBOT_LOG_LEVEL=INFO
